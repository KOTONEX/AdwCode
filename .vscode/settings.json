{
  // 本仓库的开发与外观试用配置；缩进和第三方文件例外由 .editorconfig 管理。
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "[javascript][json][jsonc][css][svg][yaml]": {
    "editor.tabSize": 2
  },
  "[markdown]": {
    "files.trimTrailingWhitespace": false,
    "editor.wordWrap": "on"
  },

  "javascript.validate.enable": true,

  // 跟随系统明暗模式；四个主题分别用于普通及高对比度预览。
  "window.autoDetectColorScheme": true,
  "workbench.preferredLightColorTheme": "AdwCode 浅色 · 彩色状态栏",
  "workbench.preferredDarkColorTheme": "AdwCode 深色",
  "workbench.preferredHighContrastLightColorTheme": "AdwCode 浅色 高对比度",
  "workbench.preferredHighContrastColorTheme": "AdwCode 深色 高对比度",
  "workbench.productIconTheme": "adwcode",
  "workbench.iconTheme": null,

  // GNOME Builder 风格的编辑区和导航；开启命令中心，字体沿用用户及系统配置。
  "editor.minimap.enabled": false,
  "editor.renderLineHighlight": "none",
  "editor.guides.indentation": true,
  "editor.stickyScroll.enabled": false,
  "editor.smoothScrolling": true,
  "breadcrumbs.enabled": false,
  "scm.diffDecorations": "none",
  "window.commandCenter": true,
  "window.density.editorTabHeight": "compact",
  "workbench.editor.tabSizing": "shrink",
  "workbench.tree.indent": 12,
  "workbench.list.smoothScrolling": true,

  // 隐藏缓存目录；构建日志仍可通过路径直接打开。
  "files.exclude": {
    "builddir": true,
    "target": true
  },
  "search.exclude": {
    "builddir": true,
    "target": true,
    ".tools": true,
    ".kilo/worktrees": true
  }
}

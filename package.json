{
  "name": "AdwCode",
  "displayName": "AdwCode",
  "icon": "资产/adwcode.png",
  "description": "跟随 GNOME 桌面（libadwaita 1.10）的 VS Code 主题",
  "version": "3.0.1",
  "publisher": "KOTONEX",
  "license": "SEE LICENSE IN 许可声明.md",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "gnome",
    "libadwaita",
    "adwaita",
    "gtk",
    "gtk4",
    "theme"
  ],
  "homepage": "https://github.com/KOTONEX/AdwCode",
  "bugs": {
    "url": "https://github.com/KOTONEX/AdwCode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KOTONEX/AdwCode.git"
  },
  "main": "./扩展/扩展.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "配置": "meson setup builddir",
    "构建": "meson compile -C builddir 主题",
    "校验": "meson compile -C builddir 校验",
    "检查样式": "meson compile -C builddir 检查样式",
    "test": "meson test -C builddir --print-errorlogs",
    "打包": "meson compile -C builddir 打包",
    "变更日志": "meson compile -C builddir 变更日志",
    "发布说明": "meson compile -C builddir 发布说明",
    "静态检查": "meson compile -C builddir 静态检查",
    "格式化": "meson compile -C builddir 格式化",
    "类型检查": "meson compile -C builddir 类型检查"
  },
  "contributes": {
    "configurationDefaults": {
      "window.menuBarVisibility": "compact"
    },
    "themes": [
      {
        "label": "AdwCode 深色",
        "uiTheme": "vs-dark",
        "path": "./主题/adwcode-深色.json"
      },
      {
        "label": "AdwCode 深色 · 彩色状态栏",
        "uiTheme": "vs-dark",
        "path": "./主题/adwcode-深色-彩色状态栏.json"
      },
      {
        "label": "AdwCode 深色 · 默认语法高亮",
        "uiTheme": "vs-dark",
        "path": "./主题/adwcode-深色-默认语法高亮.json"
      },
      {
        "label": "AdwCode 深色 · 默认语法高亮 · 彩色状态栏",
        "uiTheme": "vs-dark",
        "path": "./主题/adwcode-深色-默认语法高亮-彩色状态栏.json"
      },
      {
        "label": "AdwCode 深色 高对比度",
        "uiTheme": "hc-black",
        "path": "./主题/adwcode-深色-高对比度.json"
      },
      {
        "label": "AdwCode 浅色",
        "uiTheme": "vs",
        "path": "./主题/adwcode-浅色.json"
      },
      {
        "label": "AdwCode 浅色 · 彩色状态栏",
        "uiTheme": "vs",
        "path": "./主题/adwcode-浅色-彩色状态栏.json"
      },
      {
        "label": "AdwCode 浅色 · 默认语法高亮",
        "uiTheme": "vs",
        "path": "./主题/adwcode-浅色-默认语法高亮.json"
      },
      {
        "label": "AdwCode 浅色 · 默认语法高亮 · 彩色状态栏",
        "uiTheme": "vs",
        "path": "./主题/adwcode-浅色-默认语法高亮-彩色状态栏.json"
      },
      {
        "label": "AdwCode 浅色 高对比度",
        "uiTheme": "hc-light",
        "path": "./主题/adwcode-浅色-高对比度.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "adwcode",
        "label": "AdwCode",
        "path": "./产品图标/adwcode.json"
      }
    ],
    "configuration": {
      "title": "AdwCode",
      "properties": {
        "adwcode.自动重载": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "开发用：当本扩展的样式（`附加外观/*.css`、`附加外观/*.js`）、主题（`主题/*.json`）、清单或代码变化时，自动重新应用 Custom CSS 并重载窗口。"
        },
        "adwcode.界面字体": {
          "type": "string",
          "default": "",
          "markdownDescription": "界面字体族；留空时在安装 GNOME 外观时读取 GNOME 界面字体。仅指定一个字体族，代码和终端字体保持独立。修改后需重新安装外观并手动加载。"
        }
      }
    },
    "commands": [
      {
        "command": "adwcode.查看外观安装状态",
        "title": "查看外观安装状态",
        "category": "AdwCode"
      },
      {
        "command": "adwcode.安装仅关闭窗口控件",
        "title": "生成仅关闭按钮的窗口控件 CSS",
        "category": "AdwCode"
      },
      {
        "command": "adwcode.安装GNOME外观",
        "title": "安装 GNOME 外观（CSS）",
        "category": "AdwCode"
      },
      {
        "command": "adwcode.应用推荐设置",
        "title": "应用推荐设置",
        "category": "AdwCode"
      },
      {
        "command": "adwcode.恢复推荐设置",
        "title": "恢复推荐设置",
        "category": "AdwCode"
      }
    ]
  }
}

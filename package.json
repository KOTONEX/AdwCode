{
  "name": "AdwCode",
  "displayName": "AdwCode",
  "icon": "assets/adwcode.png",
  "description": "跟随 GNOME 桌面（libadwaita 1.10）的 VS Code 主题",
  "version": "2.1.0",
  "publisher": "KOTONEX",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "gnome",
    "libadwaita",
    "adwaita",
    "gtk",
    "gtk4",
    "theme"
  ],
  "homepage": "https://github.com/KOTONEX/AdwCode",
  "bugs": {
    "url": "https://github.com/KOTONEX/AdwCode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KOTONEX/AdwCode.git"
  },
  "main": "./extension/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "setup": "meson setup builddir",
    "build": "meson compile -C builddir themes",
    "build:all-accents": "python3.14t src/build.py --accents all",
    "check": "meson compile -C builddir check",
    "check:css": "meson compile -C builddir check-css",
    "test": "meson test -C builddir --print-errorlogs",
    "package": "meson compile -C builddir package",
    "lint": "meson compile -C builddir lint",
    "format": "meson compile -C builddir format",
    "typecheck": "meson compile -C builddir typecheck"
  },
  "contributes": {
    "configurationDefaults": {
      "window.menuBarVisibility": "compact"
    },
    "themes": [
      {
        "label": "AdwCode 深色",
        "uiTheme": "vs-dark",
        "path": "./themes/adwcode-dark.json"
      },
      {
        "label": "AdwCode 深色 · 彩色状态栏",
        "uiTheme": "vs-dark",
        "path": "./themes/adwcode-dark-colorful-status-bar.json"
      },
      {
        "label": "AdwCode 深色 · 默认语法高亮",
        "uiTheme": "vs-dark",
        "path": "./themes/adwcode-dark-default-syntax-highlighting.json"
      },
      {
        "label": "AdwCode 深色 · 默认语法高亮 · 彩色状态栏",
        "uiTheme": "vs-dark",
        "path": "./themes/adwcode-dark-default-syntax-highlighting-colorful-status-bar.json"
      },
      {
        "label": "AdwCode 深色 高对比度",
        "uiTheme": "hc-black",
        "path": "./themes/adwcode-dark-high-contrast.json"
      },
      {
        "label": "AdwCode 浅色",
        "uiTheme": "vs",
        "path": "./themes/adwcode-light.json"
      },
      {
        "label": "AdwCode 浅色 · 彩色状态栏",
        "uiTheme": "vs",
        "path": "./themes/adwcode-light-colorful-status-bar.json"
      },
      {
        "label": "AdwCode 浅色 · 默认语法高亮",
        "uiTheme": "vs",
        "path": "./themes/adwcode-light-default-syntax-highlighting.json"
      },
      {
        "label": "AdwCode 浅色 · 默认语法高亮 · 彩色状态栏",
        "uiTheme": "vs",
        "path": "./themes/adwcode-light-default-syntax-highlighting-colorful-status-bar.json"
      },
      {
        "label": "AdwCode 浅色 高对比度",
        "uiTheme": "hc-light",
        "path": "./themes/adwcode-light-high-contrast.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "adwcode",
        "label": "AdwCode",
        "path": "./product-icons/adwcode.json"
      }
    ],
    "configuration": {
      "title": "AdwCode",
      "properties": {
        "adwcode.autoAccent": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "跟随 GNOME 系统强调色（`org.gnome.desktop.interface accent-color`），同步 AdwCode 当前主题及普通明暗首选主题的已安装变体。保留其他主题、高对比度和工作区覆盖的值。"
        },
        "adwcode.autoReload": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "开发用：当本扩展的样式（`extras/*.css`、`extras/*.js`）、主题（`themes/*.json`）、清单或代码变化时，自动重新应用 Custom CSS 并重载窗口。"
        },
        "adwcode.uiFontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "界面字体族；留空时在安装 GNOME 外观时读取 GNOME 界面字体。仅指定一个字体族，代码和终端字体保持独立。修改后需重新安装外观并手动加载。"
        }
      }
    },
    "commands": [
      {
        "command": "adwcode.appearanceStatus",
        "title": "查看外观安装状态",
        "category": "AdwCode"
      },
      {
        "command": "adwcode.syncAccent",
        "title": "立即同步强调色",
        "category": "AdwCode"
      },
      {
        "command": "adwcode.closeOnlyControls",
        "title": "生成仅关闭按钮的窗口控件 CSS",
        "category": "AdwCode"
      },
      {
        "command": "adwcode.installGnomeLook",
        "title": "安装 GNOME 外观（CSS）",
        "category": "AdwCode"
      },
      {
        "command": "adwcode.applyRecommendedSettings",
        "title": "应用推荐设置",
        "category": "AdwCode"
      },
      {
        "command": "adwcode.revertRecommendedSettings",
        "title": "恢复推荐设置",
        "category": "AdwCode"
      }
    ]
  }
}

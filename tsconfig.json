    //
    // 扩展 JS 的类型检查：不产出文件（noEmit），只对 extension/extension.js
    // 做 checkJs 校验。vscode 与 Node 运行时由 types/ 下的手写最小类型面提供，
    // 无需 @types/vscode、@types/node 等 npm 依赖。
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022"],
        "types": [],
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": [
        "extension/extension.js",
        "types/**/*.d.ts"
    ]
}

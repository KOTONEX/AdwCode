{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "rootDir": ".",
    "outDir": "builddir/脚本",
    "moduleDetection": "legacy"
  },
  "include": [
    "扩展/**/*.ts",
    "附加外观/**/*.ts",
    "测试/**/*.ts",
    "基准/**/*.ts",
    "类型声明/**/*.d.ts"
  ]
}
